# Copy this file to ".env" and fill in your PayPal SANDBOX app credentials.
# Create the app (free) at https://developer.paypal.com/dashboard/applications/sandbox
# while signed in with your PayPal account: Apps & Credentials -> Sandbox ->
# Create App. Never commit the real .env — it is gitignored.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: bring your own Agent-Shield key. If left blank, the demo gets a
# free key automatically (POST /v1/signup — 1,000 scans/day, no email) and
# caches it in .shield_key.
AGENT_SHIELD_API_KEY=
